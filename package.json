{
  "name": "ghostlens",
  "version": "1.0.0",
  "description": "Chromium Manifest V3 extension for real-time 100% local AI detection, humanization, and blocking",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@tanstack/react-virtual": "^3.13.2",
    "dompurify": "^3.2.4",
    "idb": "^8.0.2",
    "lucide-react": "^1.16.0",
    "pako": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.9",
    "@types/pako": "^2.0.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@wxt-dev/module-react": "^1.1.3",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wxt": "^0.19.28"
  }
}
